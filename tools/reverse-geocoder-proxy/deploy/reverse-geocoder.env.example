# Copy this file to a protected location outside the repository.
# The upstream must be an approved, self-hosted or contractually approved
# Nominatim-compatible provider. Do not use the public endpoint for production.
NOMINATIM_URL=https://nominatim.internal.example/reverse
NOMINATIM_USER_AGENT=LaoJi-reverse-geocoder/1.0 (ops@example.invalid)
# Optional provider contact address required by some deployments.
# NOMINATIM_EMAIL=ops@example.invalid
NOMINATIM_TIMEOUT_SECONDS=5
NOMINATIM_MIN_INTERVAL_SECONDS=1.05
NOMINATIM_CACHE_TTL_SECONDS=86400
NOMINATIM_CACHE_SIZE=512
# Optional offline city-level fallback. It never produces street-level
# addresses and is reported to the app as low-confidence city data.
# LAOJI_REVERSE_GEOCODER_OFFLINE_CITY=1

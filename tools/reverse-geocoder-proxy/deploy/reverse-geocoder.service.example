[Unit]
Description=LaoJi reverse geocoder candidate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=laoji
Group=laoji
WorkingDirectory=/opt/laoji/reverse-geocoder-proxy
EnvironmentFile=/etc/laoji/reverse-geocoder.env
ExecStart=/opt/laoji/venv/bin/python3 -m uvicorn server:app --host 127.0.0.1 --port 8079
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/laoji/reverse-geocoder

[Install]
WantedBy=multi-user.target

{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "environment": "development",
      "android": { "buildType": "apk" },
      "env": {
        "APP_ENV": "development",
        "EXPO_ALLOW_CLEARTEXT": "true"
      },
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "channel": "preview",
      "env": {
        "APP_ENV": "preview",
        "EXPO_ALLOW_CLEARTEXT": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_ALLOW_CLEARTEXT": "false"
      }
    }
  }
}

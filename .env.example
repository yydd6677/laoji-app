# These documentation-only values intentionally do not point to the LaoJi
# deployment. Keep APP_ENV=development here: an actual production submission
# rejects reserved example domains, while production-rehearsal is only for a
# signed HTTPS/WSS build-pipeline rehearsal.
APP_ENV=development
EXPO_PUBLIC_API_BASE=https://laoji.cloud
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://www.example.com/privacy
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://www.example.com/terms
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://www.example.com/account-deletion
# Release A writes a shadow SQLite copy while existing screens keep reading legacy storage.
EXPO_PUBLIC_LOCAL_MEETING_DB_V1=true
# Release B is the default for migrated scopes. Per-scope shadow import and
# dual-read preflight still fail closed to legacy when any identity or content
# mismatch is detected.
EXPO_PUBLIC_LOCAL_MEETING_DB_CANONICAL_READ_V1=true
# Guest writes become canonical after the successful read cutover. Account root
# and upload ownership remain independently reversible below.
EXPO_PUBLIC_LOCAL_MEETING_DB_CANONICAL_WRITE_V1=true
# Account root is canonical by default. Upload still fails closed unless the
# current session receives a fresh recording_assets_v2 capability response.
EXPO_PUBLIC_LOCAL_MEETING_DB_ACCOUNT_ROOT_WRITE_V1=true
EXPO_PUBLIC_LOCAL_MEETING_DB_ACCOUNT_UPLOAD_WRITE_V1=true
# Remote cross-meeting search stays disabled until its candidate service and
# cross-account permission audit are complete.
EXPO_PUBLIC_MEETING_CROSS_MEETING_SEARCH_V1=false
# vNext candidates are fail-closed and must be enabled explicitly in an
# isolated build after the corresponding server capability is available.
EXPO_PUBLIC_SCHEDULE_GRAPH_V2_CANDIDATE=false
EXPO_PUBLIC_REALTIME_ASR_V2_CANDIDATE=false
EXPO_PUBLIC_MEETING_QUESTIONS_Q2_CANDIDATE=false
EXPO_PUBLIC_MEETING_SUMMARY_SOURCE_STREAM_CANDIDATE=false
EXPO_PUBLIC_NATIVE_PROJECTION_ENVELOPE_CANDIDATE=false

{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.18.7",
    "@react-navigation/native": "^7.3.7",
    "@react-navigation/native-stack": "^7.17.9",
    "expo": "^54.0.0",
    "expo-av": "~16.0.8",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-live-audio-stream": "^1.1.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.5.1",
    "react-native-zip-archive": "^8.0.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "adm-zip": "^0.6.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "patch-package": "^8.0.1",
    "test-renderer": "^1.1.0",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start",
    "android": "expo run:android",
    "android:dev": "expo run:android",
    "android:emulator": "emulator -avd LaoJi_API_35",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "audit:dependencies": "npm audit --omit=dev --audit-level=moderate",
    "audit:public": "node scripts/check_publication_boundary.js --require-gitleaks",
    "typecheck": "tsc --noEmit",
    "test:ci": "jest --runInBand",
    "verify:android-artifact": "node scripts/check_android_artifact.js",
    "materialize:aab": "node scripts/materialize_aab_for_emulator.js",
    "test": "jest --watchAll=false",
    "test:watch": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.{ts,tsx}"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "strict": true,
            "esModuleInterop": true,
            "jsx": "react-jsx"
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "<rootDir>/__mocks__/async-storage.js",
      "^expo-secure-store$": "<rootDir>/__mocks__/expo-secure-store.js",
      "^expo-file-system/legacy$": "<rootDir>/__mocks__/expo-file-system-legacy.js",
      "^expo-notifications$": "<rootDir>/__mocks__/expo-notifications.js",
      "^expo-constants$": "<rootDir>/__mocks__/expo-constants.js",
      "^expo-sharing$": "<rootDir>/__mocks__/expo-sharing.js",
      "^react-native-safe-area-context$": "<rootDir>/__mocks__/react-native-safe-area-context.js",
      "^react-native-zip-archive$": "<rootDir>/__mocks__/react-native-zip-archive.js",
      "^react-native$": "<rootDir>/__mocks__/react-native.js"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ]
  },
  "overrides": {
    "postcss": "8.5.10",
    "uuid": "11.1.1"
  },
  "private": true
}

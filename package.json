    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "laoji-native-platform": "file:./modules/laoji-native-platform",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.5.1",
    "react-native-zip-archive": "^8.0.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "adm-zip": "^0.6.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "patch-package": "^8.0.1",
    "test-renderer": "^1.1.0",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start",
    "android": "expo run:android",
    "android:dev": "expo run:android",
    "android:emulator": "emulator -avd LaoJi_API_35",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "audit:dependencies": "npm audit --omit=dev --audit-level=moderate",
    "audit:public": "node scripts/check_publication_boundary.js --require-gitleaks",
    "audit:feishu-evidence": "python3 scripts/feishu_evidence_gate.py check --mode static",
    "audit:feishu-source": "python3 scripts/feishu_evidence_gate.py check --mode static",
    "verify:feishu-release": "python3 scripts/feishu_evidence_gate.py check --mode release",
    "sync:feishu-evidence": "python3 scripts/feishu_evidence_gate.py sync-docs",
    "test:feishu-gate": "python3 -m unittest scripts.tests.test_feishu_evidence_gate",
    "audit:feishu-ui-ast": "node scripts/feishu_ui_ast_gate.js check",
    "report:feishu-ui-ast": "node scripts/feishu_ui_ast_gate.js report --output build/feishu-ui-ast-report.json",
    "test:feishu-ui-ast": "node scripts/tests/test_feishu_ui_ast_gate.js",
    "audit:android-native": "node scripts/check_android_native_boundary.js",
    "test:android-route-smoke": "bash scripts/tests/test_android_emulator_route_smoke.sh",
    "verify:android-routes": "bash scripts/android-emulator-route-smoke.sh",
    "verify:android-smoke": "bash scripts/android-emulator-smoke.sh",
    "verify:android-bounded": "bash scripts/android-emulator-soak.sh",
    "typecheck": "tsc --noEmit",
    "test:ci": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "verify:release-config": "node scripts/check_release_config.js",
    "verify:android-artifact": "node scripts/check_android_artifact.js",
    "materialize:aab": "node scripts/materialize_aab_for_emulator.js",
    "test": "jest --watchAll=false",
    "test:watch": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.{ts,tsx}"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "strict": true,
            "esModuleInterop": true,
            "jsx": "react-jsx"
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "<rootDir>/__mocks__/async-storage.js",
      "^expo-secure-store$": "<rootDir>/__mocks__/expo-secure-store.js",
      "^expo-file-system/legacy$": "<rootDir>/__mocks__/expo-file-system-legacy.js",
      "^expo-notifications$": "<rootDir>/__mocks__/expo-notifications.js",
      "^expo-localization$": "<rootDir>/__mocks__/expo-localization.js",
      "^expo-constants$": "<rootDir>/__mocks__/expo-constants.js",
      "^expo-sharing$": "<rootDir>/__mocks__/expo-sharing.js",
      "^react-native-safe-area-context$": "<rootDir>/__mocks__/react-native-safe-area-context.js",
      "^react-native-zip-archive$": "<rootDir>/__mocks__/react-native-zip-archive.js",
      "^laoji-native-platform$": "<rootDir>/__mocks__/laoji-native-platform.js",
      "^react-native$": "<rootDir>/__mocks__/react-native.js"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 78,
        "branches": 67,
        "functions": 77,
        "lines": 83
      },
      "./src/utils/eventIdentity.ts": {
        "statements": 90,
        "branches": 90,
        "functions": 100,
        "lines": 100
      },
      "./src/services/eventDeleteTransactions.ts": {
        "statements": 92,
        "branches": 84,
        "functions": 100,
        "lines": 95
      },
      "./src/services/eventEditTransactions.ts": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      },
      "./src/services/eventDeleteCoordinator.ts": {
        "statements": 80,
        "branches": 58,
        "functions": 75,
        "lines": 85
      },
      "./src/services/eventEditCoordinator.ts": {
        "statements": 78,
        "branches": 60,
        "functions": 80,
        "lines": 83
      },
      "./src/services/notifications.ts": {
        "statements": 82,
        "branches": 70,
        "functions": 78,
        "lines": 88
      },
      "./src/services/eventCache.ts": {
        "statements": 80,
        "branches": 74,
        "functions": 84,
        "lines": 90
      },
      "./src/utils/dayTimelineLayout.ts": {
        "statements": 95,
        "branches": 83,
        "functions": 100,
        "lines": 100
      },
      "./src/utils/monthEventLayout.ts": {
        "statements": 90,
        "branches": 67,
        "functions": 100,
        "lines": 95
      }
    }
  },
  "overrides": {
    "postcss": "8.5.10",
    "uuid": "11.1.1"
  },
  "private": true
}

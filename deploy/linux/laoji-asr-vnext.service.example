[Unit]
Description=LaoJi vNext isolated Qwen3-ASR service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace these paths for the isolated candidate host. Do not point this unit
# at the production service's working tree or environment file.
User=laoji-vnext
Group=laoji-vnext
WorkingDirectory=/opt/laoji-vnext
EnvironmentFile=/etc/laoji-vnext/asr.env
Environment=PYTHONUNBUFFERED=1
Environment=QWEN_ASR_PORT=8031
Environment=QWEN_ASR_DEVICE=cpu
Environment=CUDA_VISIBLE_DEVICES=
ExecStart=/opt/laoji-vnext/.venv/bin/python /opt/laoji-vnext/services/laoji-asr/server.py
Restart=on-failure
RestartSec=5
TimeoutStartSec=900
TimeoutStopSec=60
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target

# Candidate-only environment. Keep credentials in a root-readable deployment
# secret file; never commit R2 keys, device secrets, or model tokens here.
QWEN_ASR_MODEL=/opt/laoji-vnext/models/qwen3-asr/Qwen3-ASR-1.7B
QWEN_ASR_MODEL_REVISION=replace-with-pinned-model-revision
QWEN_ASR_MAX_BATCH_SIZE=8
QWEN_ASR_MAX_AUDIO_BYTES=8388608
QWEN_ASR_MAX_QUEUED_REQUESTS=64
QWEN_ASR_MICROBATCH_ENABLED=1
QWEN_ASR_MICROBATCH_WINDOW_MS=12
QWEN_ASR_MICROBATCH_MAX_ITEMS=8
QWEN_ASR_MICROBATCH_MAX_AUDIO_MS=14000
QWEN_ASR_SILENCE_RMS_THRESHOLD=0.0005
QWEN_ASR_SILENCE_PEAK_THRESHOLD=0.002
QWEN_ASR_REQUEST_WAIT_SECONDS=900

# Candidate-only API environment. Fill database/R2 values outside Git.
DATABASE_URL=sqlite+aiosqlite:////var/lib/laoji-vnext/api.db
AUDIO_STORAGE_PATH=/var/lib/laoji-vnext/audio
LOCAL_MODEL_DIR=/opt/laoji-vnext/models
LOCAL_DEVICE=cpu
CAMPPLUS_MODEL_DIR=/opt/laoji-vnext/models/campplus/zh-cn
MEETING_ASR_WARMUP_ENABLED=1
R2_ENABLED=0
# Candidate-only object namespace. Production should keep its own prefix.
R2_OBJECT_PREFIX=vnext-staging-candidate
LAOJI_INTERNAL_ASR_PORT=8031
QWEN_ASR_READY_URL=http://127.0.0.1:8031/ready
QWEN_ASR_V2_BATCH_URL=http://127.0.0.1:8031/v2/asr/batch
LAOJI_VNEXT_IMPORT_TRANSCRIPTION_ENABLED=1
LAOJI_VNEXT_MEDIA_UPLOAD_BARRIER_ENABLED=0
LAOJI_LLM_READINESS_EMBED_TIMEOUT=10

# Non-secret production settings. Keep credentials in the private environment
# file named by the systemd unit, never in this repository or service file.
DATABASE_URL=sqlite+aiosqlite:////home/LAOJI_USER/laoji-service-platform/compact-production/backend/local.db
LAOJI_DB_PATH=/home/LAOJI_USER/laoji-service-platform/compact-production/backend/schedule.db
LAOJI_SPEAKER_DB_PATH=/home/LAOJI_USER/laoji-service-platform/compact-production/backend/data/speaker_voiceprints.db
LAOJI_LOCATION_CACHE_DB_PATH=/home/LAOJI_USER/laoji-service-platform/compact-production/backend/data/location_reverse_cache.db
AUDIO_STORAGE_PATH=/home/LAOJI_USER/laoji-service-platform/compact-production/backend/audio_files
LOCAL_MODEL_DIR=/home/LAOJI_USER/laoji-service-platform/compact-production/backend/models
LOCAL_DEVICE=cuda
CAMPPLUS_MODEL_DIR=/home/LAOJI_USER/laoji-service-platform/compact-production/backend/models/campplus/zh-cn
MEETING_ASR_WARMUP_ENABLED=1
R2_ENABLED=true
R2_OBJECT_PREFIX=laoji-production
# Reuse the upload-verification byte stream for local compressed-media decode.
# The cache is bounded, private (systemd UMask=0077), and removed at Task terminal.
VNEXT_VERIFIED_MEDIA_CACHE_ENABLED=1
VNEXT_VERIFIED_MEDIA_CACHE_PATH=/home/LAOJI_USER/laoji-service-platform/compact-production/backend/data/verified-media-cache
VNEXT_VERIFIED_MEDIA_CACHE_MAX_SOURCE_BYTES=536870912
VNEXT_VERIFIED_MEDIA_CACHE_MAX_TOTAL_BYTES=4294967296
VNEXT_VERIFIED_MEDIA_CACHE_PARTIAL_TTL_SECONDS=3600
LAOJI_INTERNAL_ASR_PORT=8030
QWEN_ASR_READY_URL=http://127.0.0.1:8030/ready
QWEN_ASR_V2_BATCH_URL=http://127.0.0.1:8030/v2/asr/batch
LAOJI_OLLAMA_BASE_URL=http://127.0.0.1:21434
LAOJI_LLM_READINESS_EMBED_TIMEOUT=10

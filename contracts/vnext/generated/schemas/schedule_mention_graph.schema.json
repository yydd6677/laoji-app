{
  "$defs": {
    "ScheduleGraphProvenance": {
      "additionalProperties": false,
      "properties": {
        "draft_revision": {
          "minimum": 1,
          "title": "Draft Revision",
          "type": "integer"
        },
        "engine": {
          "enum": [
            "mobile-local",
            "server-model",
            "recognizers"
          ],
          "title": "Engine",
          "type": "string"
        },
        "engine_revision": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Engine Revision",
          "type": "string"
        },
        "parent_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Revision"
        },
        "producer_revision": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Producer Revision",
          "type": "string"
        }
      },
      "required": [
        "engine",
        "engine_revision",
        "producer_revision",
        "draft_revision"
      ],
      "title": "ScheduleGraphProvenance",
      "type": "object"
    },
    "ScheduleGraphSlots": {
      "additionalProperties": false,
      "properties": {
        "end_date": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "end_time": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Time"
        },
        "event_type": {
          "default": "once",
          "maxLength": 32,
          "title": "Event Type",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "recurrence": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recurrence"
        },
        "reminder": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reminder"
        },
        "start_date": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Date"
        },
        "start_time": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Time"
        },
        "time_period": {
          "anyOf": [
            {
              "enum": [
                "early_morning",
                "morning",
                "noon",
                "afternoon",
                "evening",
                "night"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Period"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "title": "ScheduleGraphSlots",
      "type": "object"
    },
    "ScheduleGraphSource": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "mode": {
          "enum": [
            "text",
            "audio_transcript"
          ],
          "title": "Mode",
          "type": "string"
        },
        "reference_datetime": {
          "format": "date-time",
          "title": "Reference Datetime",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "timezone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "text",
        "content_sha256",
        "mode",
        "reference_datetime",
        "timezone"
      ],
      "title": "ScheduleGraphSource",
      "type": "object"
    },
    "ScheduleMentionSpan": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "start",
        "end"
      ],
      "title": "ScheduleMentionSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "intent": {
      "enum": [
        "create",
        "query",
        "delete",
        "clarify",
        "reject",
        "context_edit"
      ],
      "title": "Intent",
      "type": "string"
    },
    "missing": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "title": "Missing",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/ScheduleGraphProvenance"
    },
    "route": {
      "enum": [
        "local_safe",
        "server_required",
        "preflight",
        "clarify",
        "operation",
        "reject"
      ],
      "title": "Route",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "slots": {
      "$ref": "#/$defs/ScheduleGraphSlots"
    },
    "source": {
      "$ref": "#/$defs/ScheduleGraphSource"
    },
    "source_id": {
      "maxLength": 180,
      "minLength": 8,
      "title": "Source Id",
      "type": "string"
    },
    "spans": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/ScheduleMentionSpan"
        },
        "type": "array"
      },
      "title": "Spans",
      "type": "object"
    },
    "state": {
      "enum": [
        "complete",
        "needs_clarification",
        "operation",
        "reject",
        "incomplete"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "source",
    "source_id",
    "intent",
    "route",
    "slots",
    "state",
    "provenance"
  ],
  "title": "ScheduleMentionGraph",
  "type": "object"
}

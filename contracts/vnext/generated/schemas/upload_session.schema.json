{
  "$defs": {
    "UploadPartReceipt": {
      "additionalProperties": false,
      "properties": {
        "etag": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Etag",
          "type": "string"
        },
        "part_number": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Part Number",
          "type": "integer"
        }
      },
      "required": [
        "part_number",
        "etag"
      ],
      "title": "UploadPartReceipt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_generation": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Asset Generation",
      "type": "string"
    },
    "asset_id": {
      "maxLength": 180,
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "binding_generation": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Binding Generation",
      "type": "string"
    },
    "binding_id": {
      "maxLength": 180,
      "minLength": 8,
      "title": "Binding Id",
      "type": "string"
    },
    "binding_revision": {
      "minimum": 1,
      "title": "Binding Revision",
      "type": "integer"
    },
    "cancel_revision": {
      "minimum": 0,
      "title": "Cancel Revision",
      "type": "integer"
    },
    "client_operation_id": {
      "maxLength": 180,
      "minLength": 8,
      "title": "Client Operation Id",
      "type": "string"
    },
    "expected_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Expected Sha256",
      "type": "string"
    },
    "expected_size": {
      "maximum": 1073741824,
      "minimum": 1,
      "title": "Expected Size",
      "type": "integer"
    },
    "expires_at": {
      "minimum": 0,
      "title": "Expires At",
      "type": "integer"
    },
    "mime_type": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Mime Type",
      "type": "string"
    },
    "mode": {
      "enum": [
        "single",
        "multipart"
      ],
      "title": "Mode",
      "type": "string"
    },
    "object_completed": {
      "default": false,
      "title": "Object Completed",
      "type": "boolean"
    },
    "part_size": {
      "minimum": 5242880,
      "title": "Part Size",
      "type": "integer"
    },
    "put_url": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Put Url"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_id": {
      "maxLength": 180,
      "minLength": 8,
      "title": "Session Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "provisioning",
        "active",
        "completing",
        "verified",
        "cleanup_pending",
        "cancelled",
        "expired"
      ],
      "title": "State",
      "type": "string"
    },
    "total_parts": {
      "maximum": 10000,
      "minimum": 1,
      "title": "Total Parts",
      "type": "integer"
    },
    "transcription_task_id": {
      "anyOf": [
        {
          "maxLength": 180,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transcription Task Id"
    },
    "uploaded_parts": {
      "items": {
        "$ref": "#/$defs/UploadPartReceipt"
      },
      "maxItems": 10000,
      "title": "Uploaded Parts",
      "type": "array"
    },
    "verified_asset_id": {
      "anyOf": [
        {
          "maxLength": 180,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verified Asset Id"
    }
  },
  "required": [
    "session_id",
    "binding_id",
    "binding_generation",
    "binding_revision",
    "cancel_revision",
    "client_operation_id",
    "asset_id",
    "asset_generation",
    "expected_size",
    "expected_sha256",
    "mime_type",
    "mode",
    "part_size",
    "total_parts",
    "state",
    "expires_at"
  ],
  "title": "UploadSession",
  "type": "object"
}
